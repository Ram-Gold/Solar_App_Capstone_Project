# Supabase Configuration (Client Publishable Keys)
# Replace with your project credentials or add these in Vercel > Settings > Environment Variables
VITE_SUPABASE_URL=https://gkrdwzbxpstpqpvqlwbt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_v-0oU01z8p2tRSFM64sbjg_Ruqr_y9c

# Vercel Serverless Email Transport (Optional - Gmail SMTP App Password)
# When configured in Vercel Environment Variables, /api/send-confirmation-email
# sends rich HTML confirmation emails to any customer address via Gmail SMTP.
# If omitted, the platform automatically falls back to Supabase Auth's built-in mailer.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Forgot Password endpoint (/api/forgot-password) - server-side only, never VITE_-prefixed
# Required for customer password reset emails. Uses the same GMAIL_* SMTP variables above.
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin used in reset links (defaults to https://jdforcesolar.com)
PUBLIC_SITE_URL=
